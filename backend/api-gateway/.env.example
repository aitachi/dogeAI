# API网关配置示例

# 数据库连接
DATABASE_URL=postgresql://postgres:postgres@localhost/api_gateway

# Redis连接
REDIS_URL=redis://127.0.0.1:6379

# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# 上游API配置
UPSTREAM_API_URL=https://api.anthropic.com
UPSTREAM_API_KEY=your-upstream-api-key

# 日志配置
LOG_LEVEL=info
LOG_FORMAT=text

# 缓存配置
CACHE_LOCAL_TTL_SECS=60
