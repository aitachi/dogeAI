# ========================================
# 大模型API代理服务 - 环境变量配置
# ========================================

# ========== OpenAI ==========
OPENAI_API_KEY=sk-your-openai-key-here

# ========== 通义千问（阿里云）==========
QWEN_API_KEY=sk-your-qwen-key-here

# ========== 智谱AI (ChatGLM) ==========
CHATGLM_API_KEY=your-chatglm-key-here

# ========== DeepSeek ==========
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# ========== 百度文心一言 ==========
BAIDU_API_KEY=your-baidu-key-here

# ========== 服务配置 ==========
# 服务端口
SERVICE_PORT=8000

# 工作进程数（建议CPU核心数*2）
WORKERS=4

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 缓存配置
CACHE_TTL=3600

# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 限流配置
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# ========== 安全配置 ==========
# 客户端API密钥（可选，用于验证客户端）
CLIENT_API_KEYS=key1,key2,key3

# 允许的IP地址（可选，逗号分隔）
ALLOWED_IPS=0.0.0.0/0

# 启用HTTPS
ENABLE_HTTPS=false
SSL_CERT_PATH=
SSL_KEY_PATH=
