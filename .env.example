# Anthropic API Proxy Configuration
# Copy this file to .env and update with your settings

# ============== 上游API配置 ==============
UPSTREAM_API_KEY=your-upstream-api-key-here
UPSTREAM_BASE_URL=https://open.bigmodel.cn/api/anthropic

# ============== 服务配置 ==============
PROXY_HOST=0.0.0.0
PROXY_PORT=8080
MAX_CONCURRENT_REQUESTS=20

# ============== 管理员密钥 ==============
# 请修改为随机生成的强密码
ADMIN_KEY=admin-change-this-key-to-secure-random-string

# ============== 邮件配置 ==============
# SMTP服务器配置
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=your-email@qq.com
SMTP_PASSWORD=your-smtp-authorization-code

# 发件人信息
FROM_NAME=Aitachi.cloud
FROM_EMAIL=your-email@qq.com

# ============== 数据库配置 ==============
DB_PATH=/var/lib/anthropic-proxy/stats.db

# ============== 日志配置 ==============
LOG_DIR=/var/log/anthropic-proxy
LOG_LEVEL=INFO

# ============== 安全配置 ==============
# 默认每日Token限额
DEFAULT_DAILY_LIMIT=10000

# 默认有效期（天）
DEFAULT_EXPIRE_DAYS=365
